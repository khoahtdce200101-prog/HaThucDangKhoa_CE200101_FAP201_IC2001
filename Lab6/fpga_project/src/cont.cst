// Clock 50MHz
IO_LOC "i_Clk" T9;
IO_PORT "i_Clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// 3 Nút nhấn (KEY0, KEY1, KEY2)
IO_LOC "i_Switch_1" C15;
IO_PORT "i_Switch_1" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "i_Switch_2" A15;
IO_PORT "i_Switch_2" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "i_Switch_3" B16;
IO_PORT "i_Switch_3" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 3 bóng LED đơn (LED0, LED1, LED2)
IO_LOC "o_LED_1" D14;
IO_PORT "o_LED_1" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "o_LED_2" C14;
IO_PORT "o_LED_2" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "o_LED_3" B9;
IO_PORT "o_LED_3" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "o_LED_4" A9;

// Giao tiếp LED 7 đoạn qua 74HC595
IO_LOC "o_SEG7_DIO" F4;
IO_PORT "o_SEG7_DIO" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "o_SEG7_RCLK" F3;
IO_PORT "o_SEG7_RCLK" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "o_SEG7_SCLK" H4;
IO_PORT "o_SEG7_SCLK" IO_TYPE=LVCMOS33 DRIVE=8;